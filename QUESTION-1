import numpy as np
import matplotlib.pyplot as plt
from sklearn.preprocessing import StandardScaler
from sklearn.cluster import KMeans
from sklearn.decomposition import PCA
from sklearn.metrics import silhouette_score
np.random.seed(42)
age = np.random.randint(18, 60, 200)
income = np.random.randint(15, 130, 200)
spending = np.random.randint(1, 100, 200)
X = np.column_stack((age, income, spending))
scaler = StandardScaler()
X_scaled = scaler.fit_transform(X)
inertia = []
for k in range(2, 11):
    model = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )
    model.fit(X_scaled)
    inertia.append(model.inertia_)
plt.figure()
plt.plot(range(2, 11), inertia, marker='o')
plt.title("Elbow Method")
plt.xlabel("Number of Clusters")
plt.ylabel("Inertia")
plt.grid()
plt.show()
scores = []
for k in range(2, 11):
    model = KMeans(
        n_clusters=k,
        random_state=42,
        n_init=10
    )
    labels = model.fit_predict(X_scaled)

    score = silhouette_score(X_scaled, labels)
    scores.append(score)

plt.figure()
plt.plot(range(2, 11), scores, marker='o')
plt.title("Silhouette Score")
plt.xlabel("Number of Clusters")
plt.ylabel("Score")
plt.grid()
plt.show()
kmeans = KMeans(
    n_clusters=5,
    random_state=42,
    n_init=10
)

labels = kmeans.fit_predict(X_scaled)
pca = PCA(n_components=2)
X_pca = pca.fit_transform(X_scaled)
plt.figure()
plt.scatter(
    X_pca[:, 0],
    X_pca[:, 1],
    c=labels,
    cmap='viridis'
)
plt.title("Customer Segmentation using K-Means and PCA")
plt.xlabel("Principal Component 1")
plt.ylabel("Principal Component 2")
plt.colorbar(label="Cluster")
plt.grid()
plt.show()
print("BVTharun(192525155)")
print("Customer Segmentation using K-Means and PCA")
print("---------------------------------------------")
print(
    "Final Silhouette Score:",
    round(silhouette_score(X_scaled, labels), 4)
)
print("\nNumber of customers in each cluster:")
print(np.bincount(labels))
